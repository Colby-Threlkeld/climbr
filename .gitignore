# Model weights live outside git (Modal volume / object storage)
*.pt
*.onnx
*.safetensors

# --- Supabase ---
supabase/.temp/
supabase/.branches/

# --- Secrets ---
.env
.env.*
!.env.example

# --- Media: never commit photos/videos of real people ---
# Eval test sets live outside the repo (see docs/ai/evaluation.md)
worker/eval/data/
*.mp4
*.mov
*.m4v
*.heic
# Synthetic test fixtures are the only allowed media
!worker/tests/fixtures/**

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
