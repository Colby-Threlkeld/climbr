# Copy to `.env` (never commit `.env`). Keep this file in sync whenever a var is added.
# Full table: docs/architecture/conventions.md -> Environment variables

# ------------------------------------------------------------------
# App (Expo) — only EXPO_PUBLIC_* values. These end up in the app bundle,
# so they must be safe to expose. RLS protects the data.
# ------------------------------------------------------------------
# Hosted dev project (decision D2). Dashboard -> Project Settings -> API Keys -> "Publishable key".
EXPO_PUBLIC_SUPABASE_URL=https://lmxhqegtfpjakzkxoayj.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_SENTRY_DSN=

# ------------------------------------------------------------------
# Server secrets — NEVER in the app, NEVER prefixed with EXPO_PUBLIC_.
# Production: set as Modal secrets and `npx supabase secrets set`.
# Local worker dev: put these in worker/.env (gitignored), not the root .env.
# ------------------------------------------------------------------
# Modal secret + Supabase function secret
SUPABASE_SERVICE_ROLE_KEY=
# Modal secret only
ANTHROPIC_API_KEY=
# Supabase function secret + Modal secret (Edge Function -> worker HMAC)
WORKER_WEBHOOK_SECRET=
